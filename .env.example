# Application
NODE_ENV=development
PORT=5000
API_PREFIX=api
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=course-rep-management-system
DB_SSL=false

# Cache (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=cr:

# JWT Secrets (Generate secure 64-byte hex strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# SMTP / Brevo Mailer
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SENDER=notifications@yourdomain.com

# Arkesel SMS
ARKESEL_API_KEY=your_arkesel_api_key
ARKESEL_BASE_URL=https://sms.arkesel.com/sms/api?action=send-sms&
ARKESEL_SENDER_ID=COURSE REP

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
